<template>
  <div class="page">
    <text class="title">{{entryName}}</text>
    <text class="subtitle">{{buildLabel}} · 系统录音测试</text>
    <text class="status">{{statusText}}</text>
    <text class="detail">{{detailText}}</text>
    <input class="action" type="button" value="检测手机连接" onclick="checkPhone" />
    <input class="action" type="button" value="诊断快应用接口" onclick="probeCapabilities" />
    <input class="record" type="button" value="录音 10 秒" onclick="startRecording" />
    <input class="cancel" type="button" value="取消录音" onclick="cancelRecording" />
    <input class="action" type="button" value="应用更新" onclick="openUpdates" />
    <input class="action" type="button" value="诊断与日志" onclick="openDiagnostics" />
  </div>
</template>
<script>
import entry from '../../common/entry.json'
import capability from '../../common/record-capability.cjs'
import diagnostics from '../../common/diagnostics.cjs'
export default {
  private: { entryName: entry.name, buildLabel: entry.version, statusText: '等待检测', detailText: '首次测试请保持此页亮屏', recording: false, recorder: null, connection: null, audioId: '', alive: true, logs: null, logTimer: null },
  onInit() { this.alive = true; try { this.logs = new diagnostics.Diagnostics(entry, require('@system.storage')); this.logs.load(() => { this.logs.record('app_started', {}); this.flushLogs(); }); this.logTimer = setInterval(() => { this.flushLogs(); }, 15000); } catch (error) {} this.checkPhone() },
  onShow() { this.checkPhone() },
  onDestroy() { if (this.logTimer) clearInterval(this.logTimer); this.alive = false },
  flushLogs() {
    if (!this.logs || !this.connection || !this.alive || this.recording) return;
    var events = this.logs.batch(); if (!events.length) return;
    try { this.connection.send({ data: { protocol: 1, type: 'diag_batch', entryId: entry.id, events: events }, success: function () {}, fail: function () {} }); } catch (error) {}
  },
  checkPhone() {
    try {
      if (!this.connection) this.connection = require('@system.interconnect').instance();
      this.connection.onmessage = (event) => {
        try {
          var message = typeof event.data === 'string' ? JSON.parse(event.data) : event.data;
          if (message.type === 'diag_ack' && message.entryId === entry.id && this.logs) { this.logs.ack(message.ids); this.flushLogs(); }
          if (message.type === 'probe_capabilities_request' && message.entryId === entry.id && this.alive) this.probeCapabilities();
          if (message.type === 'probe_status' && message.entryId === entry.id && message.audioId === this.audioId && this.alive) { this.statusText = '电脑已收到音频'; this.detailText = message.bytes + ' 字节，尚未执行任务' }
          if (message.type === 'record_status' && message.entryId === entry.id && this.alive) { this.statusText = String(message.text || ''); this.detailText = '系统录音机 · 手环麦克风'; this.recording = message.recording === true; }
          if (message.type === 'probe_text' && message.entryId === entry.id && this.alive) { this.recording = false; this.statusText = '电脑转写结果（未发送）'; this.detailText = String(message.text || '').slice(0, 180) }
          if (message.type === 'draft_ready' && message.entryId === entry.id && message.status === 'unsubmitted' && this.alive) {
            this.recording = false; this.statusText = '转写草稿预览（未发送）'; this.detailText = String(message.text || '').slice(0, 180);
            this.connection.send({ data: { protocol: 1, type: 'draft_ack', entryId: entry.id, id: message.id }, success: function () {}, fail: function () {} });
          }
        } catch (error) {}
      };
      this.connection.getReadyState({ success: (result) => { if (this.alive) { this.statusText = result.status === 1 ? '手机已连接' : '手机伴侣未连接'; if (result.status === 1) { this.detailText = '通过手机调用系统录音机'; this.connection.send({ data: { protocol: 1, type: 'ota_hello', entryId: entry.id, versionCode: entry.versionCode, version: entry.version }, success: function () {}, fail: function () {} }) } } }, fail: (error, code) => { if (this.alive) this.statusText = '连接错误 ' + code } });
    } catch (error) { this.statusText = '通信接口不可用'; this.detailText = String(error.message || error).slice(0, 100) }
  },
  inspectRecorder() {
    var query = null;
    try { var app = require('@system.app'); if (app && typeof app.canIUse === 'function') query = function (name) { return app.canIUse(name) } } catch (error) {}
    return capability.inspectRecord(function () { return require('@system.record') }, query);
  },
  openUpdates() {
    if (this.recording) { this.statusText = '请等待录音处理结束'; return; }
    try { require('@system.router').push({ uri: '/pages/update' }); } catch (error) { this.statusText = '无法打开更新页面'; }
  },
  openDiagnostics() { if (this.recording) { this.statusText = '请等待录音处理结束'; return; } try { require('@system.router').push({ uri: '/pages/diagnostics' }); } catch (error) { this.statusText = '无法打开诊断页面'; } },
  probeCapabilities() {
    var result = this.inspectRecorder();
    var info = result.report;
    this.recorder = result.recorder;
    this.statusText = info.state === 'method_available' ? '录音方法存在，待实录' : info.state === 'module_missing' ? '当前运行时未提供录音模块' : info.state === 'start_missing' ? '录音模块缺少 start 方法' : '录音模块加载异常';
    this.detailText = info.state + '\nstart: ' + info.start + ' / default: ' + info.nestedStart + '\ncanIUse: ' + info.canIUseRecord + ' / ' + info.canIUseStart;
    if (this.logs) { this.logs.record('record_' + info.state, info, info.state === 'method_available' ? 'info' : 'error'); this.flushLogs(); }
    if (this.connection) { try { this.connection.send({ data: { protocol: 1, type: 'probe_capabilities', entryId: entry.id, version: entry.version, record: info }, success: function () {}, fail: function () {} }); } catch (error) {} }
  },
  startRecording() {
    if (this.recording) return;
    if (!this.connection) { this.checkPhone(); return; }
    this.audioId = 'audio_' + Date.now().toString(36);
    this.recording = true; this.statusText = '请求手环系统录音'; this.detailText = '手机直连通道 · 录音10秒';
    try { this.connection.send({ data: { protocol: 1, type: 'record_request', entryId: entry.id, audioId: this.audioId, durationMs: 10000 }, success: function () {}, fail: (error, code) => { this.recording = false; this.statusText = '录音请求发送失败 ' + code; } }); }
    catch (error) { this.recording = false; this.statusText = '手机通道不可用'; }
  },
  cancelRecording() {
    var oldId = this.audioId; this.recording = false;
    if (oldId && this.connection) { try { this.connection.send({ data: { protocol: 1, type: 'record_cancel', entryId: entry.id, audioId: oldId }, success: function () {}, fail: function () {} }) } catch (error) {} }
    this.audioId = ''; if (this.alive) this.statusText = '已取消';
  }
}
</script>
<style>
.page { width:336px;height:480px;background-color:#10151b;flex-direction:column;align-items:center;padding:20px; }
.title { color:#f5f7fa;font-size:28px;height:40px;font-weight:bold; }
.subtitle { color:#93a7bb;font-size:15px;height:28px;text-align:center; }
.status { color:#77d8bd;font-size:21px;height:50px;text-align:center; }
.detail { color:#d0d8e0;font-size:16px;height:70px;text-align:center; }
.action,.record,.cancel { width:272px;height:34px;margin-bottom:7px;font-size:18px;border-radius:12px; }
.action { background-color:#263a50;color:#ffffff; }.record { background-color:#137a66;color:#ffffff; }.cancel { background-color:#34343e;color:#ffffff; }
</style>
